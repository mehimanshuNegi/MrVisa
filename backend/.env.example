# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/nimufly

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Admin Seeding Credentials (Only used during initial seed)
DEFAULT_ADMIN_NAME=NimuFly Admin
DEFAULT_ADMIN_EMAIL=admin@nimufly.com
DEFAULT_ADMIN_PASSWORD=Admin@NimuFly2026!

# Object Storage (Cloudflare R2 / AWS S3 Compatible)
# If disabled or unset, server falls back to local file storage for development
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=nimufly-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
SIGNED_URL_EXPIRY_SECONDS=900

# Razorpay Payment Gateway Configuration
# When keys are left empty, payment service runs in verified MOCK mode for local development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
